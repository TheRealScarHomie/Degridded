<PscollectionRoot count="11" game="Planet Coaster 2">
	<prepared_statements>
		<preparedstatement>
			<statement_name>DGGetNewVariantNames</statement_name>
			<sql_query>SELECT p.SceneryPartName FROM ModularSceneryParts p JOIN UIData u ON u.SceneryPartName = p.SceneryPartName WHERE p.DataPrefabName = 'OnGrid' AND (p.SceneryPartName || '_ScalableScenery') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddTagsScalable</statement_name>
			<sql_query>INSERT INTO Metadata_Tags (SceneryPart, Tag) SELECT t.SceneryPart || '_ScalableScenery', CASE WHEN t.Tag = 'Filter_GridProperty_Grid' THEN 'Filter_GridProperty_OffGrid' ELSE t.Tag END FROM Metadata_Tags t JOIN ModularSceneryParts p ON p.SceneryPartName = t.SceneryPart WHERE p.DataPrefabName = 'OnGrid' AND (t.SceneryPart || '_ScalableScenery') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddThemingScalable</statement_name>
			<sql_query>INSERT OR IGNORE INTO Theming (SceneryPartName, Weight, Radius, FalloffRadius) SELECT th.SceneryPartName || '_ScalableScenery', th.Weight, th.Radius, th.FalloffRadius FROM Theming th JOIN ModularSceneryParts p ON p.SceneryPartName = th.SceneryPartName WHERE p.DataPrefabName = 'OnGrid' AND (th.SceneryPartName || '_ScalableScenery') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddSimulationScalable</statement_name>
			<sql_query>INSERT OR IGNORE INTO Simulation (SceneryPartName, BuildCost, HourlyRunningCost, ResearchPack, RequiresUnlockInSandbox) SELECT s.SceneryPartName || '_ScalableScenery', s.BuildCost, s.HourlyRunningCost, s.ResearchPack, s.RequiresUnlockInSandbox FROM Simulation s JOIN ModularSceneryParts p ON p.SceneryPartName = s.SceneryPartName WHERE p.DataPrefabName = 'OnGrid' AND (s.SceneryPartName || '_ScalableScenery') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddUIDataScalable</statement_name>
			<sql_query>INSERT OR IGNORE INTO UIData (SceneryPartName, LabelTextSymbol, DescriptionTextSymbol, Icon, ReleaseGroup) SELECT u.SceneryPartName || '_ScalableScenery', u.LabelTextSymbol, u.DescriptionTextSymbol, u.SceneryPartName, u.ReleaseGroup FROM UIData u JOIN ModularSceneryParts p ON p.SceneryPartName = u.SceneryPartName WHERE p.DataPrefabName = 'OnGrid' AND (u.SceneryPartName || '_ScalableScenery') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddPartsScalable</statement_name>
			<sql_query>INSERT OR IGNORE INTO ModularSceneryParts (SceneryPartName, PrefabName, DataPrefabName, ContentPack, UGCID, BoxXSize, BoxYSize, BoxZSize) SELECT SceneryPartName || '_ScalableScenery', SceneryPartName, 'SurfaceScaling', ContentPack, UGCID, BoxXSize, BoxYSize, BoxZSize FROM ModularSceneryParts WHERE DataPrefabName = 'OnGrid';</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddTagsSurface</statement_name>
			<sql_query>INSERT INTO Metadata_Tags (SceneryPart, Tag) SELECT t.SceneryPart || '_SurfaceScaling', CASE WHEN t.Tag = 'Filter_GridProperty_Grid' THEN 'Filter_GridProperty_OffGrid' ELSE t.Tag END FROM Metadata_Tags t JOIN ModularSceneryParts p ON p.SceneryPartName = t.SceneryPart WHERE p.DataPrefabName = 'OnGrid' AND (t.SceneryPart || '_SurfaceScaling') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddThemingSurface</statement_name>
			<sql_query>INSERT OR IGNORE INTO Theming (SceneryPartName, Weight, Radius, FalloffRadius) SELECT th.SceneryPartName || '_SurfaceScaling', th.Weight, th.Radius, th.FalloffRadius FROM Theming th JOIN ModularSceneryParts p ON p.SceneryPartName = th.SceneryPartName WHERE p.DataPrefabName = 'OnGrid' AND (th.SceneryPartName || '_SurfaceScaling') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddSimulationSurface</statement_name>
			<sql_query>INSERT OR IGNORE INTO Simulation (SceneryPartName, BuildCost, HourlyRunningCost, ResearchPack, RequiresUnlockInSandbox) SELECT s.SceneryPartName || '_SurfaceScaling', s.BuildCost, s.HourlyRunningCost, s.ResearchPack, s.RequiresUnlockInSandbox FROM Simulation s JOIN ModularSceneryParts p ON p.SceneryPartName = s.SceneryPartName WHERE p.DataPrefabName = 'OnGrid' AND (s.SceneryPartName || '_SurfaceScaling') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddUIDataSurface</statement_name>
			<sql_query>INSERT OR IGNORE INTO UIData (SceneryPartName, LabelTextSymbol, DescriptionTextSymbol, Icon, ReleaseGroup) SELECT u.SceneryPartName || '_SurfaceScaling', u.LabelTextSymbol, u.DescriptionTextSymbol, u.SceneryPartName, u.ReleaseGroup FROM UIData u JOIN ModularSceneryParts p ON p.SceneryPartName = u.SceneryPartName WHERE p.DataPrefabName = 'OnGrid' AND (u.SceneryPartName || '_SurfaceScaling') NOT IN (SELECT SceneryPartName FROM ModularSceneryParts);</sql_query>
		</preparedstatement>
		<preparedstatement>
			<statement_name>DGAddPartsSurface</statement_name>
			<sql_query>INSERT OR IGNORE INTO ModularSceneryParts (SceneryPartName, PrefabName, DataPrefabName, ContentPack, UGCID, BoxXSize, BoxYSize, BoxZSize) SELECT SceneryPartName || '_SurfaceScaling', SceneryPartName, 'SurfaceScaling', ContentPack, UGCID, BoxXSize, BoxYSize, BoxZSize FROM ModularSceneryParts WHERE DataPrefabName = 'OnGrid';</sql_query>
		</preparedstatement>
	</prepared_statements>
</PscollectionRoot>
